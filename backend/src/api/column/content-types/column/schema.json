{
  "kind": "collectionType",
  "collectionName": "columns",
  "info": {
    "singularName": "column",
    "pluralName": "columns",
    "displayName": "Column"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "board": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::board.board",
      "inversedBy": "columns"
    },
    "cards": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::card.card",
      "mappedBy": "column"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
